# Reference only — the actual test suite (tests/conftest.py) overrides
# settings in-process via FastAPI dependency overrides and never reads this
# file, so nothing here needs to be "real". Kept for anyone running the app
# manually against a scratch database in a test-like mode:
# `ENVIRONMENT=testing uvicorn app.main:app --env-file .env.test`

ENVIRONMENT=testing
APP_NAME=Resume Parsing Service (test)
DEBUG=True

DATABASE_URL=postgresql+asyncpg://resume_user:resume_password@localhost:5432/resume_db_test

UPLOAD_DIRECTORY=uploads_test
MAX_FILE_SIZE=10485760
MAX_REQUEST_SIZE=12582912

ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

RATE_LIMIT_UPLOAD=1000/minute
RATE_LIMIT_PARSE=1000/minute

LOG_FORMAT=text
