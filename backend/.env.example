# Copy this file to `.env` and adjust as needed.
# For other environments see .env.test (reference only) and .env.production
# (a template — fill in and rename, never commit the filled version).

ENVIRONMENT=development
APP_NAME=Resume Parsing Service
DEBUG=True

# Async SQLAlchemy URL (asyncpg driver). When running via docker-compose,
# "db" is the Postgres service hostname.
DATABASE_URL=postgresql+asyncpg://resume_user:resume_password@db:5432/resume_db

UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=10485760
# Hard cap on any request body (checked before routing); should stay a
# little above MAX_FILE_SIZE to leave room for multipart overhead.
MAX_REQUEST_SIZE=12582912

# Comma-separated. "*" (the default) is convenient for local development;
# production must set explicit values (enforced by Settings validation).
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# slowapi rate-limit strings, e.g. "20/minute", "100/hour".
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_PARSE=20/minute

# "text" (human-readable console output) or "json" (structured, for log aggregators).
LOG_FORMAT=text
