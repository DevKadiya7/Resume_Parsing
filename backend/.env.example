# Copy this file to `.env` and adjust as needed.

APP_NAME=Resume Parsing Service
DEBUG=True

# Async SQLAlchemy URL (asyncpg driver). When running via docker-compose,
# "db" is the Postgres service hostname.
DATABASE_URL=postgresql+asyncpg://resume_user:resume_password@db:5432/resume_db

UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=10485760
