# Template for a production deployment. Copy to `.env`, then replace every
# placeholder below — `Settings` validates these at startup and refuses to
# boot if ENVIRONMENT=production but DEBUG/ALLOWED_HOSTS/ALLOWED_ORIGINS are
# still left at their permissive development defaults.
#
# Do not commit the real filled-in file — only this template belongs in
# version control.

ENVIRONMENT=production
APP_NAME=Resume Parsing Service
DEBUG=False

# Use a secrets manager / orchestrator-injected env var in real deployments
# rather than a checked-in value.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<production-db-host>:5432/<db-name>

UPLOAD_DIRECTORY=/data/uploads
MAX_FILE_SIZE=10485760
MAX_REQUEST_SIZE=12582912

# Comma-separated, no wildcards — required in production (see Settings validation).
ALLOWED_HOSTS=api.yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com

RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_PARSE=20/minute

# Structured logs for ingestion by a log aggregator (Datadog, CloudWatch, ELK, ...).
LOG_FORMAT=json
