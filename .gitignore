.vscode/
.idea/
.DS_Store
Thumbs.db

# Guards against a Python venv accidentally created at the repo root instead
# of backend/.venv (backend/.gitignore already covers the real one).
.venv/
venv/

# Source dataset (859 PDFs + a 66 MB CSV). Git is the wrong place for a
# corpus this size — it would bloat every clone forever, and the data is
# reproducible from its original source.
archive/

# Merged training dataset (~22 MB), regenerated deterministically by
# backend/ml/01_build_dataset.ipynb from archive/ with a fixed seed.
backend/ml/data/

# Jupyter checkpoint noise
.ipynb_checkpoints/
